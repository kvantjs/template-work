{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "css:build": "tailwindcss -i ./src/index.css -o ./public/styles.css",
    "build": "npm run css:build && ryvax build",
    "export": "ryvax export --out-dir dist",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "ryvax:doctor": "ryvax doctor",
    "ryvax:routes": "ryvax routes"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/cli": "^4.1.14",
    "@kvantjs/ryvax.js": "^2.1.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.11.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.3",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
